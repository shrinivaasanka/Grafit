 '\n'
 '    Lorentz [label="Lorentz Transformation", shape=oval, '
 'fillcolor="#D8BFD8"];\n'
 '    Xeq [label="x\' = γ(x - vt)"];\n'
 '    Teq [label="t\' = γ(t - vx/c²)"];\n'
 '    YZeq [label="y\' = y\\nz\' = z"];\n'
 '\n'
 '    Inverse [label="Inverse Lorentz Transformation"];\n'
 '    InvX [label="x = γ(x\' + vt\')"];\n'
 '    InvT [label="t = γ(t\' + vx\'/c²)"];\n'
 '\n'
 '    Interval [label="Spacetime Interval", fillcolor="#D1ECF1"];\n'
 '    IntervalEq [label="s² = c²t² - x² - y² - z²"];\n'
 '    InvariantInterval [label="Invariant under Lorentz transformation"];\n'
 '\n'
 '    Consequences [label="Consequences of Special Relativity", '
 'fillcolor="#FADBD8"];\n'
 '    TimeDilation [label="Time Dilation\\nΔt = γ Δτ"];\n'
 '    LengthContraction [label="Length Contraction\\nL = L₀ / γ"];\n'
 '    Simultaneity [label="Relativity of Simultaneity"];\n'
 '    VelocityAddition [label="Velocity Addition\\nu\' = (u - v)/(1 - '
 'uv/c²)"];\n'
 '    EnergyMomentum [label="Relativistic Energy-Momentum"];\n'
 '    MassEnergy [label="Mass-Energy Equivalence\\nE = mc²"];\n'
 '\n'
 '    Minkowski [label="Minkowski Spacetime", fillcolor="#E2E3E5"];\n'
 '    FourVectors [label="Four-vectors\\nxμ = (ct, x, y, z)"];\n'
 '    Metric [label="Metric\\nη = diag(1, -1, -1, -1)"];\n'
 '\n'
 '    ClassicalLimit [label="Classical Limit\\nv << c"];\n'
 '    Galilean [label="Galilean Transformation\\nx\' = x - vt\\nt\' = t"];\n'
 '\n'
 '    SR -> Postulates;\n'
 '    Postulates -> Relativity;\n'
 '    Postulates -> LightSpeed;\n'
 '\n'
 '    SR -> Frames;\n'
 '    Frames -> StandardConfig;\n'
 '    StandardConfig -> Coordinates;\n'
 '\n'
 '    SR -> Assumptions;\n'
 '    Assumptions -> Homogeneity;\n'
 '    Assumptions -> Isotropy;\n'
 '    Assumptions -> Linearity;\n'
 '\n'
 '    Homogeneity -> Linearity [label="implies"];\n'
 '    Linearity -> GeneralForm;\n'
 '    StandardConfig -> GeneralForm;\n'
 '    LightSpeed -> LightCone;\n'
 '    LightCone -> Invariance;\n'
 '    Invariance -> GeneralForm [label="constrains"];\n'
 '    GeneralForm -> Gamma [label="solving gives"];\n'
 '    Gamma -> Lorentz;\n'
 '\n'
 '    Lorentz -> Xeq;\n'
 '    Lorentz -> Teq;\n'
 '    Lorentz -> YZeq;\n'
 '    Beta -> Gamma [label="defines"];\n'
 '\n'
 '    Lorentz -> Inverse;\n'
 '    Inverse -> InvX;\n'
 '    Inverse -> InvT;\n'
 '\n'
 '    Lorentz -> Interval;\n'
 '    Interval -> IntervalEq;\n'
 '    IntervalEq -> InvariantInterval;\n'
 '    Lorentz -> InvariantInterval [label="preserves"];\n'
 '\n'
 '    SR -> Consequences;\n'
 '    Lorentz -> TimeDilation [label="implies"];\n'
 '    Lorentz -> LengthContraction [label="implies"];\n'
 '    Lorentz -> Simultaneity [label="implies"];\n'
 '    Lorentz -> VelocityAddition [label="implies"];\n'
 '    SR -> EnergyMomentum;\n'
 '    EnergyMomentum -> MassEnergy;\n'
 '\n'
 '    SR -> Minkowski;\n'
 '    Minkowski -> FourVectors;\n'
 '    Minkowski -> Metric;\n'
 '    Metric -> Interval;\n'
 '    FourVectors -> Lorentz [label="transformed by"];\n'
 '\n'
 '    Lorentz -> ClassicalLimit;\n'
 '    ClassicalLimit -> Galilean [label="γ ≈ 1"];\n'
 '}\n'
 '```\n'
